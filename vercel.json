{
  "version": 2,
  "routes": [
    {
      "src": "/server/(.*)",
      "dest": "/api/blocked"
    },
    {
      "src": "/data/(?!practice[.]js$).*",
      "dest": "/api/blocked"
    },
    {
      "src": "/result",
      "dest": "/api/result"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
